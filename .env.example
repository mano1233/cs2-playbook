# Copy to .env.local for development.
DATABASE_URL=postgres://playbook:playbook@localhost:5433/playbook

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Must match where the browser actually reaches this service. Steam echoes it back and
# we compare, so a wrong value fails the login rather than redirecting somewhere odd.
PUBLIC_BASE_URL=http://localhost:3000

# Optional: avatars and display names only.
STEAM_API_KEY=

# Lineup screenshots. Not needed until the upload work lands.
R2_BUCKET=cs2-playbook
R2_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
